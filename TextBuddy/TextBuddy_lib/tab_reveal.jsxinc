/**********************************************************************
 TextBuddy — Reveal tab: one click builds a complete word-by-word
 reveal — a new text animator (what to animate, Based On, Smoothness)
 with its Offset already keyed 0% -> 100% over Frames from the
 playhead. The Offset buttons re-key it wherever the playhead is.

 Spliced into TextBuddy.jsx's closure via //@include — not a
 standalone script.
**********************************************************************/

// ------------------------------------------------------------------
// Animator presets. The amount is the state the selected units sit
// in: Offset 0% holds every word there, Offset 100% releases them
// all back to normal.
// ------------------------------------------------------------------

var REVEAL_ANIM_NAME = "TextBuddy";

// axis: see textAmount
var REVEAL_PROPS = [
    { label: "Opacity",    match: "ADBE Text Opacity",     def: 0,  min: 0,      max: 100,   unit: "%" },
    { label: "Position Y", match: "ADBE Text Position 3D", def: 50, min: -10000, max: 10000, unit: "px", axis: 1 },
    { label: "Scale",      match: "ADBE Text Scale 3D",    def: 0,  min: -10000, max: 10000, unit: "%" },
    { label: "Rotation",   match: "ADBE Text Rotation",    def: 45, min: -3600,  max: 3600,  unit: "°" },
    { label: "Blur",       match: "ADBE Text Blur",        def: 20, min: 0,      max: 1000,  unit: "px" }
];

// Range Selector > Advanced > Based On, in AE's menu order (1-based)
var BASED_ON = ["Characters", "Characters Excl. Spaces", "Words", "Lines"];

// ------------------------------------------------------------------
// Build the reveal
// ------------------------------------------------------------------

// Every press makes its own animator, named "TextBuddy <Property>"
// and numbered when that name is already on the layer, so a pile of
// reveals stays readable in the timeline
function revealAnimatorName(layer, spec) {
    var base = REVEAL_ANIM_NAME + " " + spec.label;
    var anims = textAnimators(layer);
    var taken = {};
    for (var i = 1; i <= anims.numProperties; i++) taken[anims.property(i).name] = true;
    var name = base;
    for (var n = 2; taken[name] === true; n++) name = base + " " + n;
    return name;
}

// Index of the layer's newest TextBuddy animator, or 0 when it has none
function newestRevealAnimator(layer) {
    var anims = textAnimators(layer);
    for (var i = anims.numProperties; i >= 1; i--) {
        if (anims.property(i).name.indexOf(REVEAL_ANIM_NAME) === 0) return i;
    }
    return 0;
}

// One complete reveal on layer: a new animator, its range selector
// (Based On, Smoothness), the property at amount, and the Offset
// keyed 0% at t0 -> 100% at t1. With stack, the property goes onto
// the layer's newest TextBuddy animator instead and rides its
// existing Offset keys, so Opacity + Position Y share one sweep
// (a fade-up). Returns { isNew, offset, value }.
function revealOn(layer, spec, amount, basedOn, smooth, stack, t0, t1) {
    var ai = stack ? newestRevealAnimator(layer) : 0;
    var isNew = (ai === 0);
    if (isNew) ai = ensureAnimator(layer, revealAnimatorName(layer, spec), true).index;
    var si = ensureRangeSelector(layer, ai);
    var vp = ensureAnimProp(layer, ai, spec.match);
    setNow(vp, textAmount(spec, vp.value, amount), t0);

    var sel = selectorAt(layer, ai, si);
    setAdvanced(sel, "ADBE Text Range Type2", "Based On", basedOn, t0);
    // Smoothness only exists for the Square shape (AE's default); a
    // selector switched to another shape just keeps it hidden
    setAdvanced(sel, "ADBE Text Selector Smoothness", "Smoothness", smooth, t0);

    var off = sel.property("ADBE Text Percent Offset");
    // a stacked property keeps the animator's timing, unless it was
    // never keyed (an animator from the old Add Animator, say)
    if (isNew || off.numKeys === 0) linearSweep(off, t0, 0, t1, 100);
    if (!isNew) {
        var a = animatorAt(layer, ai);
        if (a.name.indexOf(spec.label) < 0) a.name += " + " + spec.label;
    }

    // re-fetched: the adds above can invalidate older references
    return {
        isNew: isNew,
        offset: selectorAt(layer, ai, si).property("ADBE Text Percent Offset"),
        value: ensureAnimProp(layer, ai, spec.match)
    };
}

function addReveal(spec, amount, basedOn, smooth, frames, stack) {
    var comp = activeComp();
    if (comp === null) { setStatus("Open a composition first."); return; }
    var layers = selectedTextLayers(comp);
    if (layers.length === 0) { setStatus("Select a text layer first."); return; }

    var t0 = comp.time;
    var t1 = t0 + frames * comp.frameDuration;
    var stacked = 0, revealed = false, lastErr = null;
    var offs = [], show = [];
    var i;
    app.beginUndoGroup(SCRIPT_NAME + ": " + spec.label + " reveal");
    try {
        for (i = 0; i < layers.length; i++) {
            try {
                var r = revealOn(layers[i], spec, amount, basedOn, smooth, stack, t0, t1);
                if (!r.isNew) stacked++;
                offs.push(r.offset);
                show.push(r.offset);
                show.push(r.value);
            } catch (e) { lastErr = e; }
        }
        if (offs.length > 0) {
            // Offset keys selected = a GraphBuddy ease (or the next
            // Offset click) lands on exactly these
            selectOnly(comp, offs, true);
            revealed = revealProps(show, t0);
        }
    } finally {
        app.endUndoGroup();
    }

    if (offs.length === 0) {
        setStatus("Couldn't animate the selected text" + (lastErr === null ? "." : ": " + errText(lastErr)));
        return;
    }
    var msg = spec.label + " " + amount + spec.unit + ", " + BASED_ON[basedOn - 1] + " → " +
              offs.length + (offs.length === 1 ? " layer" : " layers");
    if (stacked > 0) msg += ", " + (stacked === offs.length ? "stacked" : stacked + " stacked") + " on the last TextBuddy animator";
    else msg += ", " + frames + "f from " + playheadLabel(comp, t0);
    if (!revealed) msg += " — press U to see the keys";
    setStatus(msg);
}

// ------------------------------------------------------------------
// Offset keys
// ------------------------------------------------------------------

function keyRevealOffset(pct) {
    var comp = activeComp();
    if (comp === null) { setStatus("Open a composition first."); return; }
    var sels = textSelectorTargets(comp);
    if (sels.length === 0) {
        setStatus("Select a text layer with an animator (click Animate first).");
        return;
    }

    var t = comp.time;
    var label = "Offset " + pct + "%";
    var offs = [];
    var skipped = 0, revealed = false;
    app.beginUndoGroup(SCRIPT_NAME + ": " + label);
    try {
        for (var i = 0; i < sels.length; i++) {
            try {
                // Index units hide the percent Offset; keying it would do nothing
                if (sels[i].property("ADBE Text Range Advanced").property("ADBE Text Range Units").value === 2) {
                    skipped++;
                    continue;
                }
                var off = sels[i].property("ADBE Text Percent Offset");
                off.setValueAtTime(t, pct);
                offs.push(off);
            } catch (e) {}
        }
        if (offs.length > 0) revealed = showKeys(comp, offs, t);
    } finally {
        app.endUndoGroup();
    }

    if (offs.length === 0) {
        setStatus(skipped > 0 ? "Those selectors use Index units — switch Units to Percentage." :
                                "Couldn't key Offset on the selected text.");
        return;
    }
    var msg = label + " → " + offs.length + (offs.length === 1 ? " selector" : " selectors") +
              " at " + playheadLabel(comp, t);
    if (skipped > 0) msg += ", " + skipped + " skipped (Index units)";
    if (!revealed) msg += " — press U to see the keys";
    setStatus(msg);
}

// ------------------------------------------------------------------
// Tab builder
// ------------------------------------------------------------------

function buildRevealTab(tp) {
    var tab = makeTab(tp, "Reveal");
    var i;

    // what to animate + the amount the hidden words sit at
    var rp = row(tab);
    rp.alignChildren = ["left", "center"];
    var names = [];
    for (i = 0; i < REVEAL_PROPS.length; i++) names.push(REVEAL_PROPS[i].label);
    var ddProp = rp.add("dropdownlist", undefined, names);
    ddProp.selection = 0;
    ddProp.alignment = ["fill", "center"];
    ddProp.helpTip = "What the animator changes on each word before it's revealed";
    var etAmt = rp.add("edittext", undefined, String(REVEAL_PROPS[0].def));
    etAmt.characters = 4;
    etAmt.helpTip = "Where each word starts (at Offset 0%) — it animates back to normal by Offset 100%";
    tintText(etAmt, COL.text);
    var stUnit = rp.add("statictext", undefined, REVEAL_PROPS[0].unit);
    stUnit.characters = 2;
    tintText(stUnit, COL.text);

    function spec() {
        var s = ddProp.selection;
        return REVEAL_PROPS[(s === null) ? 0 : s.index];
    }
    function amount() {
        var s = spec();
        var v = clampNum(etAmt.text, s.def, s.min, s.max);
        etAmt.text = String(v);
        return v;
    }
    ddProp.onChange = function () {
        etAmt.text = String(spec().def);
        stUnit.text = spec().unit;
    };
    etAmt.onChange = amount;

    var rb = row(tab);
    rb.alignChildren = ["left", "center"];
    label(rb, "By", 40);
    var ddBy = rb.add("dropdownlist", undefined, BASED_ON);
    ddBy.selection = 2; // Words
    ddBy.alignment = ["fill", "center"];
    ddBy.helpTip = "Range Selector → Advanced → Based On: the unit that animates one at a time";

    var smCtl = sliderRow(tab, "Smooth", 0, 0, 100, 40);

    var rf = row(tab);
    rf.alignChildren = ["left", "center"];
    var frames = numField(rf, "Frames", 40, 20, 1, 600,
        "How long the reveal takes, in frames: Offset keys at 0% on the playhead and 100% this many frames later");

    var ra = row(tab);
    btn(ra, "Animate",
        "Adds a new text animator to the selected text layers with these settings and keys its " +
        "Offset 0% → 100% over Frames from the playhead, so each press is a complete reveal. " +
        "Alt-click: add the property to the layer's last TextBuddy animator instead, keeping its " +
        "timing (Opacity + Position Y = fade up).",
        function () {
            var alt = false;
            try { alt = ScriptUI.environment.keyboardState.altKey === true; } catch (e) {}
            var by = (ddBy.selection === null) ? 3 : ddBy.selection.index + 1;
            addReveal(spec(), amount(), by, smCtl.value(), frames.value(), alt);
        });

    var ro = row(tab);
    btn(ro, "Offset 0%",
        "Re-keys the Range Selector Offset at 0% on the playhead — where the reveal starts " +
        "(every word held at the amount above). Works on the selected animators, or every one " +
        "on the selected text layers. The keys end up selected and twirled open, ready for a " +
        "GraphBuddy ease.",
        function () { keyRevealOffset(0); }, "key");
    btn(ro, "Offset 100%",
        "Re-keys the Range Selector Offset at 100% on the playhead — where the reveal ends " +
        "(every word back to normal). Works on the selected animators, or every one on the " +
        "selected text layers. The keys end up selected and twirled open, ready for a " +
        "GraphBuddy ease.",
        function () { keyRevealOffset(100); }, "key");

    hint(tab, "Offsets re-key the selected animator at the playhead.");

    return tab;
}
